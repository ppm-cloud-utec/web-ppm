# Una URL por microservicio. Salen de `sls info` en cada repo, o de la consola
# de API Gateway. En Amplify van en App settings > Environment variables.
NEXT_PUBLIC_API_IDENTIDAD=https://xxxx.execute-api.us-east-1.amazonaws.com/dev
NEXT_PUBLIC_API_PORTAFOLIOS=https://xxxx.execute-api.us-east-1.amazonaws.com/dev
NEXT_PUBLIC_API_TAREAS=https://xxxx.execute-api.us-east-1.amazonaws.com/dev
NEXT_PUBLIC_API_RECURSOS=https://xxxx.execute-api.us-east-1.amazonaws.com/dev
NEXT_PUBLIC_API_PRESUPUESTOS=https://xxxx.execute-api.us-east-1.amazonaws.com/dev
NEXT_PUBLIC_API_ANALITICO=https://xxxx.execute-api.us-east-1.amazonaws.com/dev

# Mientras el backend no este desplegado, pon esto en true y la app usa datos
# simulados con la misma forma que devuelve la API.
NEXT_PUBLIC_USAR_MOCKS=false
