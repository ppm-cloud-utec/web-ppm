# URLs de las APIs del backend desplegado.
#
# Van VERSIONADAS, no en .env.local, y es deliberado: Next las incrusta en el
# bundle estatico, asi que cualquiera que abra el sitio las ve igual. No son
# secretos, son direcciones publicas. Tenerlas solo en un archivo ignorado
# hacia que un build hecho en otra maquina —o despues de limpiar ese
# archivo— saliera sin ellas y la aplicacion no encontrara su backend.
#
# Si se redespliega la infraestructura y cambian los identificadores de API
# Gateway, se recuperan con:
#   aws cloudformation describe-stacks --stack-name ms-<servicio>-dev \
#     --query "Stacks[0].Outputs[?OutputKey=='ServiceEndpoint'].OutputValue" --output text
NEXT_PUBLIC_API_IDENTIDAD=https://hw5b5suj23.execute-api.us-east-1.amazonaws.com/dev
NEXT_PUBLIC_API_PORTAFOLIOS=https://c78c035rtl.execute-api.us-east-1.amazonaws.com/dev
NEXT_PUBLIC_API_TAREAS=https://yq369o7q4k.execute-api.us-east-1.amazonaws.com/dev
NEXT_PUBLIC_API_RECURSOS=https://sitxbs7ytj.execute-api.us-east-1.amazonaws.com/dev
NEXT_PUBLIC_API_PRESUPUESTOS=https://xqk5r0tbq3.execute-api.us-east-1.amazonaws.com/dev
NEXT_PUBLIC_API_ANALITICO=https://dvynil8hte.execute-api.us-east-1.amazonaws.com/dev
